#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if ! command -v swiftlint >/dev/null 2>&1; then
  exit 0
fi

STAGED_SWIFT=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.swift$' || true)
if [ -z "$STAGED_SWIFT" ]; then
  exit 0
fi

echo "swiftlint: checking staged Swift files..."
echo "$STAGED_SWIFT" | xargs swiftlint lint --config .swiftlint.yml -- 2>&1 | head -n 200
STATUS=${PIPESTATUS[1]:-0}
if [ $STATUS -ne 0 ]; then
  echo ""
  echo "swiftlint found issues. Fix or run: scripts/lint.sh"
  echo "To bypass: git commit --no-verify"
  exit $STATUS
fi
exit 0
